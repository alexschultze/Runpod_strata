 ```
 
+### OpenAI-compatible API
+
+The endpoint also serves Runpod's OpenAI-compatible route, so the OpenAI SDKs work unchanged:
+
+```python
+from openai import OpenAI
+
+client = OpenAI(
+    base_url="https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1",
+    api_key="<RUNPOD_API_KEY>",
+)
+reply = client.chat.completions.create(
+    model="<HF_MODEL or OLLAMA_MODEL>",  # or any model name; see below
+    messages=[{"role": "user", "content": "Write a haiku about GPUs."}],
+)
+```
+
+Supported routes: `/v1/chat/completions`, `/v1/completions`, `/v1/embeddings` and `/v1/models`, including `stream=true`. They are forwarded to Ollama's own `/v1` API. `model` may be the endpoint's configured `HF_MODEL` / `OLLAMA_MODEL` (or omitted) to use the default model; any other name is pulled on demand like the native API.
+
 ### Streaming
 
 Set `"stream": true` and use `/run` + `/stream/<JOB_ID>`, or `/runsync` to receive the aggregated stream. Each chunk is a JSON line in Ollama's [streaming format](https://github.com/ollama/ollama/blob/main/docs/api.md).
diff --git a/handler.py b/handler.py
index a8cdff7..e8de147 100644
--- a/handler.py
+++ b/handler.py
@@ -983,9 +983,108 @@ def warm_default_model():
         return False
 
 
+# Routes Runpod's /openai/v1/... gateway can send, mapped to the OpenAI-compatible
+# endpoints Ollama serves natively under /v1. Anything else is rejected up front
+# rather than forwarded blindly.
+OPENAI_ROUTES = {
+    "/v1/chat/completions": "POST",
+    "/v1/completions": "POST",
+    "/v1/embeddings": "POST",
+    "/v1/models": "GET",
+}
+
+
+def resolve_openai_model(requested):
+    """Map the model name an OpenAI client sends to an Ollama model.
+
+    Clients must send *some* model name, and the obvious one is the Hugging Face
+    repo the endpoint was configured with, which is not the name Ollama
+    registered it under. Treat blank, the configured HF repo and the configured
+    OLLAMA_MODEL as "the default model"; anything else is an explicit request.
+    """
+    requested = normalize_model_name(requested if isinstance(requested, str) else "")
+    default_aliases = {normalize_model_name(DEFAULT_MODEL)}
+    if HF_MODEL:
+        default_aliases.add(normalize_model_name(HF_MODEL))
+    default_aliases.discard("")
+    if not requested or requested in default_aliases:
+        return resolve_default_model(), False
+    return requested, True
+
+
+def _openai_error(message, status=400, error_type="invalid_request_error"):
+    return {"error": {"message": message, "type": error_type, "code": status}}
+
+
+def handle_openai(job_input):
+    """Serve a request that arrived through Runpod's /openai/v1 route.
+
+    The gateway wraps the client's call as {"openai_route": "/v1/chat/completions",
+    "openai_input": {...}}. Without this the handler saw neither 'messages' nor
+    'prompt' and the gateway answered 502 Bad Gateway.
+    """
+    route = str(job_input.get("openai_route") or "").rstrip("/")
+    if route and not route.startswith("/v1"):
+        route = "/v1/" + route.lstrip("/")
+    body = job_input.get("openai_input") or {}
+    method = OPENAI_ROUTES.get(route)
+    if method is None:
+        yield _openai_error(
+            f"Unsupported OpenAI route '{route}'. Supported: {', '.join(OPENAI_ROUTES)}.",
+            404,
+            "not_found_error",
+        )
+        return
+    if not isinstance(body, dict):
+        yield _openai_error("'openai_input' must be a JSON object.")
+        return
+
+    if method == "POST":
+        model, explicit = resolve_openai_model(body.get("model"))
+        try:
+            if explicit:
+                ensure_model(model)
+            else:
+                ensure_default_model()
+        except (requests.RequestException, ValueError, OSError) as err:
+            yield _openai_error(f"Failed to prepare model '{model}': {err}", 500, "server_error")
+            return
+        body = {**body, "model": model}
+
+    url = f"{OLLAMA_BASE_URL}{route}"
+    stream = bool(body.get("stream", False)) and method == "POST"
+    try:
+        if method == "GET":
+            response = session.get(url, timeout=60)
+        else:
+            response = session.post(url, json=body, stream=stream, timeout=3600)
+        with response:
+            if not response.ok:
+                yield _openai_error(
+                    f"Ollama request failed: {ollama_error(response)}",
+                    response.status_code,
+                    "server_error",
+                )
+                return
+            if stream:
+                # Ollama emits server-sent events; keep the "data: ...\n\n" framing
+                # (including the final "data: [DONE]") the OpenAI SDKs parse.
+                for line in response.iter_lines():
+                    if line:
+                        yield line.decode("utf-8") + "\n\n"
+            else:
+                yield response.json()
+    except requests.RequestException as err:
+        yield _openai_error(f"Ollama request failed: {err}", 502, "server_error")
+
+
 def handler(job):
     job_input = job.get("input") or {}
 
+    if job_input.get("openai_route"):
+        yield from handle_openai(job_input)
+        return
+
     requested = job_input.get("model")
     model = normalize_model_name(requested) if requested else resolve_default_model()
     if not model:
diff --git a/test_openai.py b/test_openai.py
new file mode 100644
index 0000000..867cadf
--- /dev/null
+++ b/test_openai.py
@@ -0,0 +1,150 @@
+"""Unit tests for the OpenAI-compatible route in handler.py.
+
+Runpod's /openai/v1/... gateway wraps each call as
+{"openai_route": "/v1/chat/completions", "openai_input": {...}}. A handler that
+only knows 'messages'/'prompt' answers those with an error and the gateway turns
+that into a 502 Bad Gateway. No GPU, network or Ollama needed:
+
+    python3 -m pytest test_openai.py -v
+"""
+
+import json
+import sys
+import types
+
+import pytest
+
+if "runpod" not in sys.modules:
+    try:
+        import runpod  # noqa: F401
+    except ImportError:
+        sys.modules["runpod"] = types.ModuleType("runpod")
+
+import handler
+
+
+class FakeResponse:
+    def __init__(self, status_code=200, payload=None, lines=()):
+        self.status_code = status_code
+        self.ok = status_code < 400
+        self._payload = payload
+        self.text = json.dumps(payload or {})
+        self._lines = lines
+        self.request = types.SimpleNamespace(path_url="/v1/x")
+
+    def json(self):
+        return self._payload
+
+    def iter_lines(self):
+        return iter(self._lines)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+
+class FakeSession:
+    def __init__(self, response):
+        self.response = response
+        self.calls = []
+
+    def post(self, url, **kwargs):
+        self.calls.append(("POST", url, kwargs))
+        return self.response
+
+    def get(self, url, **kwargs):
+        self.calls.append(("GET", url, kwargs))
+        return self.response
+
+
+@pytest.fixture
+def env(monkeypatch):
+    ensured = []
+    monkeypatch.setattr(handler, "ensure_default_model", lambda: ensured.append("default"))
+    monkeypatch.setattr(handler, "ensure_model", lambda m: ensured.append(m))
+    monkeypatch.setattr(handler, "DEFAULT_MODEL", "smollm2:135m")
+    monkeypatch.setattr(handler, "HF_MODEL", "unsloth/SmolLM2-135M-Instruct-GGUF")
+    monkeypatch.setattr(handler, "HF_QUANTIZATION", "")
+    monkeypatch.setattr(handler, "HF_MODEL_FILE", "")
+    return ensured
+
+
+def run(job_input):
+    return list(handler.handler({"input": job_input}))
+
+
+def use_session(monkeypatch, response):
+    fake = FakeSession(response)
+    monkeypatch.setattr(handler, "session", fake)
+    return fake
+
+
+def test_chat_completion_is_forwarded_to_ollama_v1(env, monkeypatch):
+    reply = {"object": "chat.completion", "choices": [{"message": {"content": "hi"}}]}
+    fake = use_session(monkeypatch, FakeResponse(payload=reply))
+    out = run({
+        "openai_route": "/v1/chat/completions",
+        "openai_input": {"model": "unsloth/SmolLM2-135M-Instruct-GGUF",
+                         "messages": [{"role": "user", "content": "hi"}]},
+    })
+    assert out == [reply]
+    method, url, kwargs = fake.calls[0]
+    assert (method, url) == ("POST", "http://127.0.0.1:11434/v1/chat/completions")
+    # The HF repo id is an alias for the default model, which Ollama knows under
+    # its derived name.
+    assert kwargs["json"]["model"] == handler.resolve_default_model()
+    assert env == ["default"]
+
+
+def test_blank_model_uses_default(env, monkeypatch):
+    use_session(monkeypatch, FakeResponse(payload={}))
+    run({"openai_route": "/v1/completions", "openai_input": {"prompt": "x"}})
+    assert env == ["default"]
+
+
+def test_explicit_model_is_ensured(env, monkeypatch):
+    fake = use_session(monkeypatch, FakeResponse(payload={}))
+    run({"openai_route": "/v1/chat/completions",
+         "openai_input": {"model": "llama3.2:3b", "messages": [{"role": "user", "content": "x"}]}})
+    assert env == ["llama3.2:3b"]
+    assert fake.calls[0][2]["json"]["model"] == "llama3.2:3b"
+
+
+def test_streaming_keeps_sse_framing(env, monkeypatch):
+    lines = [b'data: {"id":"1"}', b"", b'data: {"id":"2"}', b"", b"data: [DONE]", b""]
+    fake = use_session(monkeypatch, FakeResponse(lines=lines))
+    out = run({"openai_route": "/v1/chat/completions",
+               "openai_input": {"stream": True, "messages": [{"role": "user", "content": "x"}]}})
+    assert out == ['data: {"id":"1"}\n\n', 'data: {"id":"2"}\n\n', "data: [DONE]\n\n"]
+    assert fake.calls[0][2]["stream"] is True
+
+
+def test_models_route_is_a_get_without_loading_a_model(env, monkeypatch):
+    listing = {"object": "list", "data": [{"id": "smollm2:135m"}]}
+    fake = use_session(monkeypatch, FakeResponse(payload=listing))
+    out = run({"openai_route": "/v1/models"})
+    assert out == [listing]
+    assert fake.calls[0][:2] == ("GET", "http://127.0.0.1:11434/v1/models")
+    assert env == []
+
+
+def test_unsupported_route_is_a_clean_error(env, monkeypatch):
+    fake = use_session(monkeypatch, FakeResponse(payload={}))
+    out = run({"openai_route": "/v1/images/generations", "openai_input": {}})
+    assert out[0]["error"]["code"] == 404
+    assert fake.calls == []
+
+
+def test_ollama_failure_is_reported_in_openai_error_shape(env, monkeypatch):
+    use_session(monkeypatch, FakeResponse(status_code=500, payload={"error": "boom"}))
+    out = run({"openai_route": "/v1/chat/completions",
+               "openai_input": {"messages": [{"role": "user", "content": "x"}]}})
+    assert out[0]["error"]["code"] == 500
+    assert "boom" in out[0]["error"]["message"]
+
+
+def test_native_requests_are_unaffected(env, monkeypatch):
+    out = run({})
+    assert "messages" in out[0]["error"]
